{
  "name": "ai-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 少年学院 (AI Kids Academy) — sub-app of 星星闯关乐园, served at /academy/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pinyin-pro": "^3.29.5",
    "pyodide": "314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
