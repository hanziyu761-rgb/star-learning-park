{
  "name": "star-learning-park",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "pinyin-pro": "^3.29.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:html": "node tools/single-html/build.js",
    "review:export": "jest --testMatch '<rootDir>/tools/review/*.review.ts' && python3 tools/review/make_xlsx.py"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
